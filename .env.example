MEGADRUM_SUPABASE_URL=https://your-project.supabase.co
MEGADRUM_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Use "production" only for the final public build. Preview builds remain noindex.
NEXT_PUBLIC_SITE_ENV=preview

# Public GA4 Measurement ID. Production defaults to the Mega Drum web property.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-5H2TDPMV28

# Optional web advertising. Keep these empty until AdSense is approved and CookieYes is configured.
# The slot enables the in-page unit; AUTO_ADS enables AdSense formats such as vignette ads.
NEXT_PUBLIC_COOKIEYES_WEBSITE_KEY=
NEXT_PUBLIC_ADSENSE_PLAY_SLOT=
NEXT_PUBLIC_ADSENSE_AUTO_ADS=false
